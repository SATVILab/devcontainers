{
  "name": "satvi-2022-rodo-thesis",
  "image": "bioconductor/bioconductor_docker:RELEASE_3_20",
  "containerUser": "rstudio",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
        "username": "rstudio",
        "installZsh": false,
        "upgradePackages": false,
        "installSsl": false
    },
    "ghcr.io/MiguelRodo/DevContainerFeatures/utils:1.1.0": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "xvfb,vim,libcurl4-openssl-dev,libsecret-1-dev,jq,fonts-texgyre"
    },
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "installTinyTex": true
    },
    "ghcr.io/MiguelRodo/DevContainerFeatures/renv-cache:1.15.3": {
      "pkg": "ggplot2",
      "update": true
    },
    "ghcr.io/MiguelRodo/DevContainerFeatures/build-info:1.4.0": {}
  }
}
